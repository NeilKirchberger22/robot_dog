<?xml version="1.0"?>
<robot name = "one leg" xmlns:xacro="http://ros.org">

    <ros2_control name = "LegHardwareInterface" type="system">
        <hardware>
        <plugin>robot_hardware/RobotHardware</plugin>

        <param name="serial_port">/dev/ttyUSB0</param>
        </hardware>

        <joint name="hip_joint">
            <command_interface name="position">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="shoulder_joint">
            <command_interface name="position">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="knee_joint">
            <command_interface name="position">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

    </ros2_control>

</robot>